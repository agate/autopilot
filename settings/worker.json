  "permissions": {
    "deny": [
      "Edit(~/.claude/autopilot-data/**/RULES.md)",
      "Edit(~/.claude/autopilot-data/RULES.md)",
      "Edit(~/.claude/autopilot-data/**/config.json)",
      "Edit(~/.claude/autopilot-data/config.json)",
      "Edit(~/.claude/autopilot-data/**/settings*.json)",
      "Edit(~/.claude/autopilot-data/settings*.json)",
      "Edit(~/.claude/autopilot-data/**/oneoff-*.json)",
      "Edit(~/.claude/autopilot-data/oneoff-*.json)",
      "Edit(~/.claude/autopilot-data/**/state.json)",
      "Edit(~/.claude/autopilot-data/state.json)",
      "Edit(~/.claude/autopilot-data/**/page.json)",
      "Edit(~/.claude/autopilot-data/page.json)",
      "Edit(~/.claude/autopilot-data/**/gate.json)",
      "Edit(~/.claude/autopilot-data/gate.json)",
      "Edit(~/.claude/autopilot-data/**/tick.json)",
      "Edit(~/.claude/autopilot-data/tick.json)",
      "Edit(~/.claude/autopilot-data/**/lock)",
      "Edit(~/.claude/autopilot-data/lock)",
      "Edit(~/.claude/autopilot-data/**/state.lock)",
      "Edit(~/.claude/autopilot-data/state.lock)",
      "Edit(~/.claude/skills/autopilot/**)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr edit --add-reviewer:*)"
